<title>Regelwerk – BuxtehudeRP</title>
<style>
:root{--bg:#07101d;--panel:#0d1929;--panel2:#111f32;--text:#f5f7fb;--muted:#a9b5c5;--accent:#3aa0ff;--accent2:#78c4ff;--line:#1c3048;--danger:#ff647c;--warning:#ffcc66}
*{box-sizing:border-box;scroll-behavior:smooth}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:linear-gradient(180deg,#06101d 0%,#091525 55%,#050c16 100%);color:var(--text);min-height:100vh}
nav{position:sticky;top:0;z-index:20;background:rgba(5,12,22,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);padding:18px 7%;display:flex;justify-content:space-between;align-items:center}
.brand{font-size:21px;font-weight:800;letter-spacing:.5px}.brand span{color:var(--accent)}nav a{color:#dce7f4;text-decoration:none;margin-left:25px;font-size:14px;transition:.2s}nav a:hover{color:var(--accent)}
.hero{padding:90px 7% 55px;background:radial-gradient(circle at 75% 30%,rgba(58,160,255,.18),transparent 34%)}
.hero-inner{max-width:900px}.eyebrow{display:inline-block;padding:8px 13px;border:1px solid #285b85;border-radius:999px;color:var(--accent2);background:rgba(58,160,255,.08);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1.4px}
h1{font-size:58px;margin:20px 0 14px;line-height:1}h1 span{color:var(--accent)}.hero p{color:var(--muted);font-size:18px;line-height:1.7;max-width:760px}
.wrapper{padding:20px 7% 80px;display:grid;grid-template-columns:270px minmax(0,1fr);gap:25px;align-items:start}
.sidebar{position:sticky;top:90px;background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:16px;padding:18px}.sidebar h3{margin:4px 0 14px}.sidebar a{display:block;color:var(--muted);text-decoration:none;padding:10px 11px;border-radius:8px;font-size:14px}.sidebar a:hover{background:rgba(58,160,255,.1);color:var(--accent2)}
.search{margin-bottom:22px;position:relative}.search input{width:100%;padding:16px 18px;border-radius:12px;border:1px solid var(--line);background:#0a1626;color:#fff;font-size:15px;outline:none}.search input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(58,160,255,.08)}
.notice{padding:18px 20px;border:1px solid #285b85;background:rgba(58,160,255,.07);border-radius:14px;color:#cfe9ff;line-height:1.6;margin-bottom:25px}
.category{margin:0 0 32px;scroll-margin-top:100px}.category-title{font-size:28px;margin:0 0 15px}.category-title span{color:var(--accent)}
.rule{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:14px;margin-bottom:12px;overflow:hidden;transition:.2s}.rule:hover{border-color:#315d85}.rule summary{list-style:none;cursor:pointer;padding:20px 22px;font-weight:700;display:flex;align-items:center;justify-content:space-between;gap:15px}.rule summary::-webkit-details-marker{display:none}.rule summary::after{content:'+';color:var(--accent);font-size:25px;font-weight:400}.rule[open] summary::after{content:'−'}.rule-body{padding:0 22px 20px;color:var(--muted);line-height:1.7}.rule-body p{margin:0 0 10px}.rule-body ul{margin:8px 0 0;padding-left:20px}.rule-body li{margin:6px 0}.important{border-color:#6e4d2a}.important summary{color:#ffe1a6}.danger{border-color:#6d3040}.danger summary{color:#ffc1cb}
.empty{display:none;text-align:center;color:var(--muted);padding:40px;border:1px dashed var(--line);border-radius:14px}
footer{border-top:1px solid var(--line);padding:28px 7%;color:#8291a4;display:flex;justify-content:space-between;font-size:13px}
@media(max-width:900px){.wrapper{grid-template-columns:1fr}.sidebar{position:static}.sidebar-links{display:grid;grid-template-columns:1fr 1fr}h1{font-size:48px}}
@media(max-width:600px){nav div:last-child{display:none}.hero{padding:70px 6% 40px}h1{font-size:40px}.wrapper{padding:15px 6% 60px}.sidebar-links{grid-template-columns:1fr}.category-title{font-size:24px}footer{gap:10px;flex-direction:column}}

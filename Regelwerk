<script>
const input=document.getElementById('searchInput');
const rules=[...document.querySelectorAll('.rule')];
const categories=[...document.querySelectorAll('.category')];
const empty=document.getElementById('emptyState');
input.addEventListener('input',()=>{
 const q=input.value.trim().toLowerCase(); let total=0;
 rules.forEach(rule=>{const match=!q||rule.textContent.toLowerCase().includes(q);rule.style.display=match?'':'none';if(match){total++;if(q)rule.open=true;}});
 categories.forEach(cat=>{const visible=[...cat.querySelectorAll('.rule')].some(r=>r.style.display!=='none');cat.style.display=visible?'':'none';});
 empty.style.display=total?'none':'block';
});
</script>
